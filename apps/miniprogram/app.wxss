page {
  min-height: 100%;
  background: #f7f7f2;
  color: #1f2937;
  font-family: sans-serif;
}

.page {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 48rpx;
}

.page__title {
  font-size: 48rpx;
  font-weight: 600;
}

.page__description {
  color: #6b7280;
  font-size: 28rpx;
}
